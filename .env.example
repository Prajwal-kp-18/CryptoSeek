# OpenRouter API Configuration (all LLM calls go through OpenRouter)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_KEY=your_openrouter_key_here
# Optional model overrides (OpenRouter model ids)
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_CRYPTO_STRINGS_MODEL=perplexity/sonar

# Ghidra Installation Path
# Update this to point to your Ghidra installation directory
GHIDRA_HOME=/path/to/ghidra

# Python Virtual Environment Directory
# Path to your Python virtual environment
VENV_DIR=/path/to/vestigo-data/.venv

# Database Configuration
# PostgreSQL connection string format:
# postgresql://username:password@host:port/database?options
DATABASE_URL=postgresql://user:password@localhost:5432/vestigo?sslmode=require

# Environment Configuration
# Set to "production" in production environments
ENVIRONMENT=development

# CORS Configuration (optional)
# Comma-separated list of additional allowed origins for CORS
# Example: ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=
